# Copy this file to .env and fill in real values. .env is gitignored.

# --- Database ---
POSTGRES_USER=webmius
POSTGRES_PASSWORD=change-me
POSTGRES_DB=webmius

# --- Backend ---
FLASK_ENV=development

# Flask session/JWT signing key - generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Key used to encrypt stored SSH credentials at rest (any random string; it is
# deterministically derived into a Fernet key) - generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=change-me

# --- Frontend ---
# URL the frontend uses to reach the backend API
VITE_API_URL=http://localhost:5000
